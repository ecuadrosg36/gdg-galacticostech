# Modo del agente: "local" (Ollama) o "cloud" (Gemini API sirviendo Gemma 4)
MODE=local

# --- Modo local (Ollama) ---
OLLAMA_MODEL=gemma4:e2b
OLLAMA_API_BASE=http://localhost:11434

CORS_ORIGINS=http://localhost:4200

# --- Modo cloud (Gemini API / Google AI Studio) ---
# Solo necesario si MODE=cloud. Consigue tu key en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_GEMMA_MODEL=gemma-4-4b-it

# --- Base de datos ---
DATABASE_URL=sqlite:///./app.db

# --- App ---
APP_NAME=tutor_educativo
